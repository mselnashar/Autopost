{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aqwal-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-08",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aqwal-database",
      "database_id": "bc83d8e0-343a-4fbf-86ff-f7f3ee9ba585"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    // بريدك الحقيقي لطلبات ويكيميديا — مهم: بدونه قد تُرفض طلبات الصور
    // "WIKI_CONTACT": "you@example.com",

    // وضع المسودات التلقائية: "1" يحفظ المنشورات التلقائية كمسودات للمراجعة بدل النشر المباشر
    "AUTO_DRAFT": "0"
  }
} 
